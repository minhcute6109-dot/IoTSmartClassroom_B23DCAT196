                  "description": "Trang cần xem (số nguyên dương >= 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Số lượng bản ghi trên một trang (số nguyên dương >= 1, tùy biến tự do theo nhu cầu, mặc định: 10)"
                },
                {
                  "key": "sort_key",
                  "value": "id",
                  "description": "Trường sắp xếp: id | device | action | status | time"
                },
                {
                  "key": "sort_dir",
                  "value": "DESC",
                  "description": "Chiều sắp xếp: ASC | DESC"
                },
                {
                  "key": "search_field",
                  "value": "all",
                  "description": "Cột tìm kiếm: device | action | status | all"
                },
                {
                  "key": "search_value",
                  "value": "",
                  "description": "Từ khóa tìm kiếm (LIKE %value%)"
                },
                {
                  "key": "device",
                  "value": "",
