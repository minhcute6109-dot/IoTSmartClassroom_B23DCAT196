        }
      ]
    },
    {
      "name": "Device",
      "description": "Theo dõi và gửi lệnh điều khiển trạng thái các thiết bị trong phòng",
      "item": [
        {
          "name": "Get Device States",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/device-states",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "device-states"
              ]
            },
            "description": "Lấy trạng thái hiện thời của 3 thiết bị trong phòng (1: Đèn, 2: Quạt, 3: Điều hòa) từ bảng Devices."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"devices\": [\n    {\n      \"device_id\": 1,\n      \"device_name\": \"Đèn\",\n      \"status\": \"ON\"\n    },\n    {\n      \"device_id\": 2,\n      \"device_name\": \"Quạt\",\n      \"status\": \"OFF\"\n    },\n    {\n      \"device_id\": 3,\n      \"device_name\": \"Điều hòa\",\n      \"status\": \"OFF\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Control Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"ON\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/devices/:device_id/control",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "devices",
                ":device_id",
                "control"
              ],
              "variable": [
                {
                  "key": "device_id",
                  "value": "1",
                  "description": "ID thiết bị cần điều khiển (1: Đèn, 2: Quạt, 3: Điều hòa)"
                }
              ]
            },
            "description": "Gửi yêu cầu điều khiển bật/tắt thiết bị.\n- Backend nhận yêu cầu, ghi bản ghi vào bảng Action với trạng thái 'PENDING'.\n- Đồng thời publish bản tin điều khiển xuống topic MQTT `Device_control`.\n- Chờ phản hồi từ phần cứng qua topic `Device_Response` (hoặc timeout 2.5 giây sẽ đánh dấu 'FAIL')."
          },
          "response": [
            {
              "name": "200 OK - Tiếp nhận lệnh thành công (PENDING)",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"action_id\": 123,\n  \"device_id\": 1,\n  \"device_name\": \"Đèn\",\n  \"action\": \"ON\",\n  \"status\": \"PENDING\",\n  \"message\": \"Device command accepted\"\n}"
            },
            {
              "name": "400 Bad Request - Sai mã thiết bị hoặc hành động",
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": false,\n  \"message\": \"Hành động điều khiển không hợp lệ. Chỉ chấp nhận: 'ON' hoặc 'OFF'.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Action History",
